public class Solution {
    public int MaxProfit(int[] prices) {
        int maxMoney = 0;//最大利润
        int slowIndex = 0;//慢指针
        int fastIndex = 1;//快指针
        int lastIndex = prices.Length - 1;//最后索引
        while(fastIndex <= lastIndex){
            int money = prices[fastIndex] - prices[slowIndex];
            if(money > maxMoney){
                maxMoney = money;
            }
            if(money<0){
                slowIndex = fastIndex;
            }
            fastIndex++;
        }
        return maxMoney;
    }
}
